{
  "name": "la-bola-negra",
  "version": "1.0.0",
  "description": "Una proposición al día para toda España. Bola blanca o bola negra, un voto por persona y en secreto.",
  "private": true,
  "type": "module",
  "author": "Marodseg - Manuel Ángel Rodríguez Segura <manuelangelrodriguezsegura@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Marodseg/la-bola-negra.git"
  },
  "homepage": "https://marodseg.github.io/la-bola-negra/",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "wrangler dev --config worker/wrangler.toml --env desarrollo --port 8787",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build",
    "db:migrar:local": "wrangler d1 migrations apply la-bola-negra --local --env desarrollo --config worker/wrangler.toml",
    "deploy:api": "wrangler deploy --config worker/wrangler.toml",
    "imagenes": "node scripts/generar-imagenes.mjs"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource/league-gothic": "^5.3.0",
    "@fontsource/libre-caslon-text": "^5.3.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  }
}
